---
import { Image } from 'astro:assets';
import figurine from '../assets/hero-figurine.png';
import type { Dictionary } from '../i18n';
import { socials } from '../i18n';
import { postsFor, postPath, langBase, fmtDate } from '../lib/blog';
import Masthead from './Masthead.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const intlLocale = { en: 'en-US', ru: 'ru-RU', be: 'be-BY' }[t.lang];
const posts = (await postsFor(t.lang)).slice(0, 3);
const projectsHref = t.lang === 'en' ? '/projects/' : `/${t.lang}/projects/`;

/* Where each of the three sits in the picture, as a percentage of its square.
   The clips are animated from this very frame, so the marks stay put while the
   figurine moves. */
const SPOT_AT = {
  me: { x: 40.5, y: 21.5 },
  bird: { x: 30, y: 25.5 },
  dog: { x: 62.5, y: 34.5 },
};
const SPOT_AUDIO = { me: '/audio/dmitriy.mp3', bird: '/audio/kenar.mp3', dog: '/audio/zoom.mp3' };
---

<Masthead t={t} />

<main id="main">
  <section class="hero">
    <div class="hero-intro">
      <p class="greeting">{t.hero.greeting}</p>
      <h1 class="name">Dmitriy Semenkevich<span class="name-dot">.</span></h1>
      <div class="chips">
        {t.hero.chips.map((c, i) => <span class={i === 1 ? 'chip chip-accent' : 'chip'}>{c}</span>)}
      </div>
      <p class="lead">{t.hero.lead}</p>
      <p class="lead lead2">{t.hero.lead2}</p>
      <div class="cta-row">
        <a class="btn" href={`mailto:${t.contact.email}`} data-magnet>{t.hero.ctaEmail}</a>
        <a class="link-plain" href="https://adlega.com" rel="noopener">{t.hero.ctaAdlega} ↗</a>
      </div>
    </div>

    <div class="scene">
      <div class="stage" data-stage data-clips="/hero/figurine-glance.mp4,/hero/figurine-breathe.mp4">
        <Image
          class="stage-still"
          src={figurine}
          alt={t.hero.photoAlt}
          widths={[420, 640, 960, 1280]}
          sizes="(max-width: 52rem) 21rem, 30rem"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
        {
          t.hero.spots.map((spot, i) => (
            <button
              class="spot"
              type="button"
              data-spot={spot.key}
              style={`--x:${SPOT_AT[spot.key].x}%;--y:${SPOT_AT[spot.key].y}%;--i:${i}`}
              aria-label={spot.label}
              aria-expanded="false"
              aria-controls={`note-${spot.key}-${t.lang}`}
            >
              <svg class="spot-stitch" viewBox="0 0 7 7" aria-hidden="true">
                <path d="M3 2h1v3H3zM2 3h3v1H2zM1 1h1v1H1zM5 1h1v1H5zM1 5h1v1H1zM5 5h1v1H5z" />
              </svg>
            </button>
          ))
        }
      </div>

      <span class="spark" data-spark aria-hidden="true"></span>

      <div class="notes">
        {
          t.hero.spots.map((spot) => (
            <article
              class="note"
              id={`note-${spot.key}-${t.lang}`}
              data-note={spot.key}
              style={`--x:${SPOT_AT[spot.key].x}%`}
              hidden
            >
              <span class="note-tail" aria-hidden="true" />
              <button class="note-close" type="button" data-note-close aria-label={t.hero.spotClose}>
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
              <h3 class="note-name">{spot.name}</h3>
              <p class="note-text">{spot.text}</p>
              <button class="note-listen" type="button" data-audio={SPOT_AUDIO[spot.key]} hidden>
                <span class="note-play" aria-hidden="true" />
                <span class="note-label">{spot.listen}</span>
                <span class="note-time" data-audio-time aria-hidden="true" />
              </button>
            </article>
          ))
        }
      </div>

      <p class="scene-hint">{t.hero.hint}</p>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section" aria-labelledby="writing-label">
        <div class="section-head reveal">
          <h2 id="writing-label">{t.blog.label}</h2>
          <svg class="squiggle" viewBox="0 0 60 14" fill="none" aria-hidden="true">
            <path d="M2 8c6-8 10 8 16 0s10 8 16 0 10 8 16 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
          </svg>
        </div>
        <div class="wr-list">
          {posts.map((p) => (
            <a class="wr-row reveal" href={postPath(p)}>
              <span class="wr-date">{fmtDate(p.data.date, t.lang)}</span>
              <span>
                <span class="wr-title">{p.data.title}</span>
                <p class="wr-desc">{p.data.description}</p>
              </span>
              <span class="wr-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
        <a class="link-plain wr-all reveal" href={langBase(t.lang)}>{t.blog.all}</a>
      </section>
    )
  }

  <section class="section" aria-labelledby="work-label">
    <div class="section-head reveal">
      <h2 id="work-label">{t.work.label}</h2>
      <svg class="squiggle" viewBox="0 0 60 14" fill="none" aria-hidden="true">
        <path d="M2 8c6-8 10 8 16 0s10 8 16 0 10 8 16 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="cards">
      {
        t.work.items.map((item, idx) => (
          <article class="card reveal">
            <div class="card-head">
              <h3>
                <a href={item.href} rel="noopener">
                  {item.title}
                </a>
              </h3>
              <span class="card-meta">
                {item.meta} · {item.linkLabel}
              </span>
            </div>
            <p class="card-tag">{item.tag}</p>
            <div class="card-body">
              {item.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            {idx === 0 && (
              <div class="toy" data-toy data-locale={intlLocale} data-months={t.toy.months}>
                <div class="toy-head">
                  <span class="toy-title">{t.toy.title}</span>
                  <span class="toy-target">{t.toy.target}</span>
                </div>
                <div class="toy-chart" data-chart></div>
                <div class="toy-controls">
                  <div class="toy-field">
                    <label for={`growth-${t.lang}`}>{t.toy.growth} — <output data-growth-out></output></label>
                    <input id={`growth-${t.lang}`} type="range" min="0" max="25" step="0.5" value="8" data-growth />
                  </div>
                  <div class="toy-field">
                    <label for={`churn-${t.lang}`}>{t.toy.churn} — <output data-churn-out></output></label>
                    <input id={`churn-${t.lang}`} type="range" min="0" max="12" step="0.5" value="3" data-churn />
                  </div>
                  <button class="toy-btn" type="button" data-solve>{t.toy.button}</button>
                </div>
                <p class="toy-note">{t.toy.note}</p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="shelf-label">
    <div class="section-head reveal">
      <h2 id="shelf-label">{t.shelf.label}</h2>
      <svg class="squiggle" viewBox="0 0 60 14" fill="none" aria-hidden="true">
        <path d="M2 8c6-8 10 8 16 0s10 8 16 0 10 8 16 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="shelf">
      {
        t.shelf.items.map((item) =>
          item.href ? (
            <a class="shelf-item reveal" href={item.href} rel="noopener">
              <div class="shelf-head">
                <span class="shelf-name">{item.name}</span>
                <span class="shelf-years">{item.years}</span>
              </div>
              <p class="shelf-note">{item.note}</p>
              <span class="shelf-status" data-status={item.status}>
                {t.shelf.statuses[item.status]}
              </span>
            </a>
          ) : (
            <div class="shelf-item reveal">
              <div class="shelf-head">
                <span class="shelf-name">{item.name}</span>
                <span class="shelf-years">{item.years}</span>
              </div>
              <p class="shelf-note">{item.note}</p>
              <span class="shelf-status" data-status={item.status}>
                {t.shelf.statuses[item.status]}
              </span>
            </div>
          ),
        )
      }
    </div>
    <a class="link-plain wr-all reveal" href={projectsHref}>{t.shelf.all}</a>
  </section>

  <section class="section" aria-labelledby="contact-label">
    <div class="contact-card reveal">
      <h2 id="contact-label" class="contact-title">{t.contact.label}</h2>
      <p class="contact-lede">{t.contact.lede}</p>
      <a class="contact-email" href={`mailto:${t.contact.email}`} data-magnet>{t.contact.email}</a>
      <div class="contact-links">
        {
          socials.map((s) => (
            <a href={s.href} rel="me noopener">
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</main>

<SiteFooter t={t} />
