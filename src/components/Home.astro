---
import { Image } from 'astro:assets';
import portrait from '../assets/dmitriy-semenkevich.jpg';
import type { Dictionary } from '../i18n';
import { dictionaries, socials } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
const langs = Object.values(dictionaries).map((d) => ({
  code: d.lang.toUpperCase(),
  href: d.path,
  current: d.lang === t.lang,
}));
const intlLocale = { en: 'en-US', ru: 'ru-RU', be: 'be-BY' }[t.lang];
---

<header class="masthead">
  <a class="wordmark" href={t.path}>dimhold<span class="dot">.</span>by</a>
  <nav class="langs" aria-label={t.langLabel}>
    {
      langs.map((l) =>
        l.current ? (
          <a href={l.href} aria-current="page">
            {l.code}
          </a>
        ) : (
          <a href={l.href}>{l.code}</a>
        ),
      )
    }
  </nav>
  <button class="lamp" data-lamp aria-label={t.lampLabel} title={t.lampLabel}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 18h6M10 21h4M12 3a6 6 0 0 1 3.6 10.8c-.6.5-.6 1.2-.6 2.2h-6c0-1-.1-1.7-.7-2.2A6 6 0 0 1 12 3Z"></path>
    </svg>
  </button>
</header>

<main id="main">
  <section class="hero">
    <div class="hero-intro">
      <p class="greeting">{t.hero.greeting}</p>
      <h1 class="name">Dmitriy Semenkevich<span class="name-dot">.</span></h1>
      <div class="chips">
        {t.hero.chips.map((c, i) => <span class={i === 1 ? 'chip chip-accent' : 'chip'}>{c}</span>)}
      </div>
      <p class="lead">{t.hero.lead}</p>
      <div class="cta-row">
        <a class="btn" href={`mailto:${t.contact.email}`} data-magnet>{t.hero.ctaEmail}</a>
        <a class="link-plain" href="https://adlega.com" rel="noopener">{t.hero.ctaAdlega} ↗</a>
      </div>
    </div>

    <div class="scene">
      <div class="scene-canvas" data-scene></div>
      <Image
        class="scene-fallback"
        data-scene-fallback
        hidden
        src={portrait}
        alt={t.hero.photoAlt}
        width={332}
        quality={85}
      />
      <p class="scene-hint">{t.hero.hint}</p>
      <p class="scene-caption">
        {t.hero.artifactLabel}: <b data-artifact-name data-artifact-names={JSON.stringify(t.artifacts)}></b>
        <br />
        {t.hero.seedLine} · seed <span data-seed></span> · <a data-seed-tomorrow href="?">{t.hero.seedTomorrow}</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="work-label">
    <div class="section-head reveal">
      <h2 id="work-label">{t.work.label}</h2>
      <svg class="squiggle" viewBox="0 0 60 14" fill="none" aria-hidden="true">
        <path d="M2 8c6-8 10 8 16 0s10 8 16 0 10 8 16 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="cards">
      {
        t.work.items.map((item, idx) => (
          <article class="card reveal">
            <div class="card-head">
              <h3>
                <a href={item.href} rel="noopener">
                  {item.title}
                </a>
              </h3>
              <span class="card-meta">
                {item.meta} · {item.linkLabel}
              </span>
            </div>
            <p class="card-tag">{item.tag}</p>
            <div class="card-body">
              {item.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            {idx === 0 && (
              <div class="toy" data-toy data-locale={intlLocale} data-months={t.toy.months}>
                <div class="toy-head">
                  <span class="toy-title">{t.toy.title}</span>
                  <span class="toy-target">{t.toy.target}</span>
                </div>
                <div class="toy-chart" data-chart></div>
                <div class="toy-controls">
                  <div class="toy-field">
                    <label for={`growth-${t.lang}`}>{t.toy.growth} — <output data-growth-out></output></label>
                    <input id={`growth-${t.lang}`} type="range" min="0" max="25" step="0.5" value="8" data-growth />
                  </div>
                  <div class="toy-field">
                    <label for={`churn-${t.lang}`}>{t.toy.churn} — <output data-churn-out></output></label>
                    <input id={`churn-${t.lang}`} type="range" min="0" max="12" step="0.5" value="3" data-churn />
                  </div>
                  <button class="toy-btn" type="button" data-solve>{t.toy.button}</button>
                </div>
                <p class="toy-note">{t.toy.note}</p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="record-label">
    <div class="section-head reveal">
      <h2 id="record-label">{t.record.label}</h2>
      <svg class="squiggle" viewBox="0 0 60 14" fill="none" aria-hidden="true">
        <path d="M2 8c6-8 10 8 16 0s10 8 16 0 10 8 16 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
    </div>
    <div class="record">
      {
        t.record.entries.map((entry) => (
          <div class="record-row reveal">
            <span class="record-years">{entry.years}</span>
            <div>
              <p class="record-title">{entry.title}</p>
              <p class="record-note">{entry.note}</p>
            </div>
          </div>
        ))
      }
    </div>
    <p class="stack-line reveal">{t.record.stack}</p>
  </section>

  <section class="section" aria-labelledby="contact-label">
    <div class="contact-card reveal">
      <h2 id="contact-label" class="greeting">{t.contact.label}</h2>
      <p class="contact-lede">{t.contact.lede}</p>
      <a class="contact-email" href={`mailto:${t.contact.email}`} data-magnet>{t.contact.email}</a>
      <div class="contact-links">
        {
          socials.map((s) => (
            <a href={s.href} rel="me noopener">
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <span class="signature reveal-mask" aria-hidden="true">Dmitriy</span>
  <div class="footer-rows">
    <span>{t.footer.colophon}</span>
    <span>{t.hero.seedLine} · seed <span data-seed></span></span>
    <span>© {year} Dmitriy Semenkevich</span>
  </div>
</footer>

<script>
  import '../scripts/site';
</script>
