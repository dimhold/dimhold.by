---
import { render } from 'astro:content';
import type { Dictionary } from '../i18n';
import type { Post } from '../lib/blog';
import { langBase, readingMinutes, fmtDate } from '../lib/blog';
import { tagLabel, tagPath } from '../lib/tags';
import Masthead from './Masthead.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  t: Dictionary;
  post: Post;
  /** Paths to this post in other languages, for the language switcher. */
  langHrefs: Partial<Record<'en' | 'ru' | 'be', string>>;
}

const { t, post, langHrefs } = Astro.props;
const { Content } = await render(post);
---

<Masthead t={t} active="blog" langHrefs={langHrefs} />

<main id="main" class="blog-page post-page">
  <a class="post-back" href={langBase(t.lang)}>← {t.blog.label}</a>
  <h1 class="post-title">{post.data.title}</h1>
  <p class="post-meta">
    {fmtDate(post.data.date, t.lang)} · {readingMinutes(post.body)}
    {t.blog.min}
  </p>
  <article class="prose">
    <Content />
  </article>
  {
    post.data.tags.length > 0 && (
      <nav class="tag-row post-tags" aria-label={t.blog.tagsLabel}>
        {post.data.tags.map((slug) => (
          <a class="tag-pill" href={tagPath(slug, t.lang)}>
            {tagLabel(slug, t.lang)}
          </a>
        ))}
      </nav>
    )
  }
</main>

{
  post.data.walk && (
    <script>
      import '../scripts/walk';
    </script>
  )
}

<SiteFooter t={t} />
