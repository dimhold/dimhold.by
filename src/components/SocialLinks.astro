---

<ul class="socials" aria-label={label}>
  {
    socials.map((s) => (
      <li>
        <a
          class="social"
          href={s.href}
          rel="me noopener"
          title={s.label}
          aria-label={s.label}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d={PATHS[s.icon]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
