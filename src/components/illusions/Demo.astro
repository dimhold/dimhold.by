---
/* Каркас демонстрации. Разметка строится из описания в lib/illusions/demos.ts, так что
   на сто с лишним экспонатов приходится один шаблон. Скрипт находит свои ручки по
   data-атрибутам и подгружается отдельным чанком: страница без демонстрации не тянет
   ничего, а страница с демонстрацией тянет только свою. */
import { DEMOS } from '../../lib/illusions/demos';

interface Props {
  /** Ключ демонстрации: он же имя в реестре. */
  id: string;
  /** Что делает ручка и зачем она тут. */
  note?: string;
}

const { id, note } = Astro.props;
const spec = DEMOS[id];
const controls = spec?.controls ?? [];
---

<figure class="ill-demo" data-ill-demo={id} tabindex="-1">
  {spec?.headphones && <p class="ill-phones">Нужны наушники: на динамиках это другой стимул, и иллюзии там нет.</p>}

  {/* Пропорции едут в атрибуте: описание живёт на сервере, а рисовальщику нужно
      знать высоту холста уже в браузере. */}
  {spec?.ratio !== 0 && <canvas class="ill-canvas" data-canvas data-ratio={spec?.ratio ?? 0.6}></canvas>}
  {spec?.stage && <div class="ill-stage" data-stage></div>}

  {
    controls.length > 0 && (
      <div class="ill-ctl">
        {controls.map((c) =>
          c.kind === 'slider' ? (
            <label>
              <span>{c.label}</span>
              <input
                type="range"
                min={c.min}
                max={c.max}
                step={c.step ?? 1}
                value={c.value}
                data-slider={c.name}
                data-fmt={c.fmt}
              />
              {/* Без формата значение не показывается: у задач на подгонку число
                  превращает измерение в арифметику. */}
              {c.fmt && <output data-out={c.name} />}
            </label>
          ) : c.kind === 'toggle' ? (
            <button type="button" class="ill-btn" data-toggle={c.name} data-off={c.label} data-on={c.on} aria-pressed="false">
              {c.label}
            </button>
          ) : c.kind === 'button' ? (
            <button type="button" class="ill-btn" data-btn={c.name}>
              {c.label}
            </button>
          ) : c.kind === 'check' ? (
            <label class="ill-check">
              <input type="checkbox" data-check={c.name} />
              <span>{c.label}</span>
            </label>
          ) : c.kind === 'select' ? (
            <label>
              <span>{c.label}</span>
              <select data-select={c.name}>
                {c.options.map((o) => (
                  <option value={o.value}>{o.label}</option>
                ))}
              </select>
            </label>
          ) : c.kind === 'clock' ? (
            <span class="ill-clock" data-clock>0,0 с</span>
          ) : (
            <span class="ill-hint">{c.label}</span>
          ),
        )}
      </div>
    )
  }

  {spec?.chart && <canvas class="ill-chart" data-chart data-ratio={spec.chart}></canvas>}

  <p class="ill-readout" data-readout aria-live="polite"></p>
  {note && <figcaption class="ill-demo-note">{note}</figcaption>}
</figure>
