---
/* Каркас демонстрации. Разметка строится из описания в lib/illusions/demos.ts, так что
   на сто с лишним экспонатов приходится один шаблон. Скрипт находит свои ручки по
   data-атрибутам и подгружается отдельным чанком: страница без демонстрации не тянет
   ничего, а страница с демонстрацией тянет только свою. */
import { DEMOS } from '../../lib/illusions/demos';
import { asset, creditLine } from '../../lib/illusions/credits';
import { dt } from '../../lib/illusions/demo-text';
import { UI } from '../../lib/illusions/ui';
import type { IllLang } from '../../lib/illusions/labels';

interface Props {
  /** Ключ демонстрации: он же имя в реестре. */
  id: string;
  /** Что делает ручка и зачем она тут. */
  note?: string;
  /** Язык страницы: подписи ручек берутся из demo-text.ts по русскому тексту. */
  lang?: IllLang;
}

const { id, note, lang = 'ru' } = Astro.props;
const ui = UI[lang].demo;
const spec = DEMOS[id];
const controls = spec?.controls ?? [];
/* Материалы подписываются всегда, даже общественное достояние, где подписи не требуют.
   Каталог собирался ради того, чтобы источник был виден. */
const credits = (spec?.credits ?? []).map((cid) => ({ cid, a: asset(cid) })).filter((x) => x.a);
---

<figure
  class="ill-demo"
  data-ill-demo={id}
  data-assets={spec?.credits?.length ? JSON.stringify(Object.fromEntries((spec.credits ?? []).map((cid) => [cid, asset(cid)?.file]))) : undefined}
  tabindex="-1"
>
  {spec?.headphones && <p class="ill-phones">{ui.headphones}</p>}

  {/* Пропорции едут в атрибуте: описание живёт на сервере, а рисовальщику нужно
      знать высоту холста уже в браузере. */}
  {spec?.ratio !== 0 && <canvas class="ill-canvas" data-canvas data-ratio={spec?.ratio ?? 0.6}></canvas>}
  {spec?.stage && <div class="ill-stage" data-stage></div>}

  {
    controls.length > 0 && (
      <div class="ill-ctl">
        {controls.map((c) =>
          c.kind === 'slider' ? (
            <label>
              <span>{dt(lang, c.label)}</span>
              <input
                type="range"
                min={c.min}
                max={c.max}
                step={c.step ?? 1}
                value={c.value}
                data-slider={c.name}
                data-fmt={c.fmt}
              />
              {/* Без формата значение не показывается: у задач на подгонку число
                  превращает измерение в арифметику. */}
              {c.fmt && <output data-out={c.name} />}
            </label>
          ) : c.kind === 'toggle' ? (
            <button type="button" class="ill-btn" data-toggle={c.name} data-off={dt(lang, c.label)} data-on={c.on && dt(lang, c.on)} aria-pressed="false">
              {dt(lang, c.label)}
            </button>
          ) : c.kind === 'button' ? (
            <button type="button" class="ill-btn" data-btn={c.name}>
              {dt(lang, c.label)}
            </button>
          ) : c.kind === 'check' ? (
            <label class="ill-check">
              <input type="checkbox" data-check={c.name} />
              <span>{dt(lang, c.label)}</span>
            </label>
          ) : c.kind === 'select' ? (
            <label>
              <span>{dt(lang, c.label)}</span>
              <select data-select={c.name}>
                {c.options.map((o) => (
                  <option value={o.value}>{dt(lang, o.label)}</option>
                ))}
              </select>
            </label>
          ) : c.kind === 'clock' ? (
            <span class="ill-clock" data-clock>{ui.clockZero}</span>
          ) : (
            <span class="ill-hint">{dt(lang, c.label)}</span>
          ),
        )}
      </div>
    )
  }

  {spec?.chart && <canvas class="ill-chart" data-chart data-ratio={spec.chart}></canvas>}

  <p class="ill-readout" data-readout aria-live="polite"></p>
  {note && <figcaption class="ill-demo-note">{note}</figcaption>}
  {
    credits.length > 0 && (
      <figcaption class="ill-credit">
        <span class="ill-credit-label">{ui.material}</span>
        <ul>
          {credits.map(({ cid, a }) => (
            <li>
              {creditLine(a!, lang, cid)}{' '}
              <a href={a!.commons} rel="noopener">
                {a!.licence}
              </a>
            </li>
          ))}
        </ul>
      </figcaption>
    )
  }
</figure>
