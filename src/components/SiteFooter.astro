---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <span class="signature reveal-mask" aria-hidden="true">Dmitriy</span>
  <div class="footer-rows">
    <span>{t.hero.seedLine} · seed <span data-seed></span></span>
    <span>© {year} Dmitriy Semenkevich</span>
  </div>
</footer>
