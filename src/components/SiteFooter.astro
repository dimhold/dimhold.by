---
import type { Dictionary } from '../i18n';
import DayLeaf from './DayLeaf.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-left">
    <DayLeaf t={t} />
    <p class="leafpad-caption">{t.leaf.caption}</p>
  </div>
  <div class="footer-sign">
    <span class="signature reveal-mask" aria-hidden="true">Dmitriy<br />Semenkevich</span>
    <div class="footer-tail">
      <SocialLinks label={t.socialsLabel} />
      <span class="footer-copy">© {year} {t.identity.full}</span>
    </div>
  </div>
</footer>
