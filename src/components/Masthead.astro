---
import type { Dictionary, Lang } from '../i18n';
import { dictionaries } from '../i18n';

interface Props {
  t: Dictionary;
  /** Which nav pill is the current page, if any. */
  active?: 'blog' | 'projects' | 'games' | 'papers';
  /** Where each language link should go; defaults to that language's home. */
  langHrefs?: Partial<Record<Lang, string>>;
}

const { t, active, langHrefs = {} } = Astro.props;
const suffix = t.lang === 'en' ? '' : `/${t.lang}`;
const nav = [
  { key: 'projects' as const, href: `${suffix}/projects/`, label: t.nav.projects },
  { key: 'blog' as const, href: `${suffix}/blog/`, label: t.nav.blog },
  { key: 'games' as const, href: `${suffix}/games/`, label: t.nav.games },
  /* The papers live in English only, so every language points at the same
     place. Better a link that crosses languages than a section reachable
     from the sitemap alone. */
  { key: 'papers' as const, href: '/papers/', label: t.nav.papers },
];
const langs = Object.values(dictionaries).map((d) => ({
  code: d.lang.toUpperCase(),
  href: langHrefs[d.lang] ?? d.path,
  current: d.lang === t.lang,
}));
---

<header class="masthead">
  <a class="wordmark" href={t.path}>dimhold<span class="dot">.</span>by</a>
  <nav class="nav-main" aria-label={t.nav.projects}>
    {
      nav.map((n) => (
        <a class="nav-pill" href={n.href} aria-current={active === n.key ? 'page' : undefined}>
          {n.label}
        </a>
      ))
    }
  </nav>
  <nav class="langs" aria-label={t.langLabel}>
    {
      langs.map((l) =>
        l.current ? (
          <a href={l.href} aria-current="page">
            {l.code}
          </a>
        ) : (
          <a href={l.href}>{l.code}</a>
        ),
      )
    }
  </nav>
  <button class="lamp" data-lamp aria-label={t.lampLabel} title={t.lampLabel}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 18h6M10 21h4M12 3a6 6 0 0 1 3.6 10.8c-.6.5-.6 1.2-.6 2.2h-6c0-1-.1-1.7-.7-2.2A6 6 0 0 1 12 3Z"></path>
    </svg>
  </button>
</header>
