---
import Base from '../../layouts/Base.astro';
import ProjectsPage from '../../components/ProjectsPage.astro';
import { en } from '../../i18n';

const alternates = [
  { lang: 'en', href: '/projects/' },
  { lang: 'ru', href: '/ru/projects/' },
  { lang: 'be', href: '/be/projects/' },
];
---

<Base
  t={en}
  title={en.projects.title}
  description={en.projects.description}
  alternates={alternates}
  ogType="website"
>
  <ProjectsPage t={en} />
</Base>
