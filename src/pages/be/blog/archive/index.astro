---
import Base from '../../../../layouts/Base.astro';
import ArchivePage from '../../../../components/ArchivePage.astro';
import { be } from '../../../../i18n';
import { archivePath } from '../../../../lib/blog';

const alternates = [
  { lang: 'en', href: archivePath('en') },
  { lang: 'ru', href: archivePath('ru') },
  { lang: 'be', href: archivePath('be') },
];
---

<Base
  t={be}
  title={be.blog.archiveTitle}
  description={be.blog.archiveDescription}
  alternates={alternates}
  ogType="website"
>
  <ArchivePage t={be} />
</Base>
