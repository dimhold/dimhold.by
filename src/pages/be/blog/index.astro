---
import Base from '../../../layouts/Base.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import { be } from '../../../i18n';

const alternates = [
  { lang: 'en', href: '/blog/' },
  { lang: 'ru', href: '/ru/blog/' },
  { lang: 'be', href: '/be/blog/' },
];
---

<Base t={be} title={be.blog.title} description={be.blog.description} alternates={alternates} ogType="website">
  <BlogIndex t={be} />
</Base>
