---
import Base from '../../../layouts/Base.astro';
import KataPiachy from '../../../components/games/KataPiachy.astro';
import { be } from '../../../i18n';

const alternates = [
  { lang: 'en', href: '/games/kata-piachy/' },
  { lang: 'ru', href: '/ru/games/kata-piachy/' },
  { lang: 'be', href: '/be/games/kata-piachy/' },
];
---

<Base
  t={be}
  title={be.games.kata.title}
  description={be.games.kata.description}
  alternates={alternates}
  ogType="website"
>
  <KataPiachy t={be} />
</Base>
