---
/* Одна иллюзия, язык be. Вся страница — в components/illusions/IllusionEntry. */
import IllusionEntry from '../../../components/illusions/IllusionEntry.astro';
import { entries, type Entry } from '../../../lib/illusions';

export function getStaticPaths() {
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props as { entry: Entry };
---

<IllusionEntry lang="be" entry={entry} />
