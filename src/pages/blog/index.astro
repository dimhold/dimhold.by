---
import Base from '../../layouts/Base.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { en } from '../../i18n';

const alternates = [
  { lang: 'en', href: '/blog/' },
  { lang: 'ru', href: '/ru/blog/' },
  { lang: 'be', href: '/be/blog/' },
];
---

<Base t={en} title={en.blog.title} description={en.blog.description} alternates={alternates} ogType="website">
  <BlogIndex t={en} />
</Base>
