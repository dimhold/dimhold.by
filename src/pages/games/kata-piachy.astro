---
import Base from '../../layouts/Base.astro';
import KataPiachy from '../../components/games/KataPiachy.astro';
import { en } from '../../i18n';

const alternates = [
  { lang: 'en', href: '/games/kata-piachy/' },
  { lang: 'ru', href: '/ru/games/kata-piachy/' },
  { lang: 'be', href: '/be/games/kata-piachy/' },
];
---

<Base
  t={en}
  title={en.games.kata.title}
  description={en.games.kata.description}
  alternates={alternates}
  ogType="website"
>
  <KataPiachy t={en} />
</Base>
