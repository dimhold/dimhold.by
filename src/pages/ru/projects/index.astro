---
import Base from '../../../layouts/Base.astro';
import ProjectsPage from '../../../components/ProjectsPage.astro';
import { ru } from '../../../i18n';

const alternates = [
  { lang: 'en', href: '/projects/' },
  { lang: 'ru', href: '/ru/projects/' },
  { lang: 'be', href: '/be/projects/' },
];
---

<Base
  t={ru}
  title={ru.projects.title}
  description={ru.projects.description}
  alternates={alternates}
  ogType="website"
>
  <ProjectsPage t={ru} />
</Base>
