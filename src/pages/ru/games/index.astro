---
import Base from '../../../layouts/Base.astro';
import GamesIndex from '../../../components/GamesIndex.astro';
import { ru } from '../../../i18n';

const alternates = [
  { lang: 'en', href: '/games/' },
  { lang: 'ru', href: '/ru/games/' },
  { lang: 'be', href: '/be/games/' },
];
---

<Base
  t={ru}
  title={ru.games.title}
  description={ru.games.description}
  alternates={alternates}
  ogType="website"
>
  <GamesIndex t={ru} />
</Base>
