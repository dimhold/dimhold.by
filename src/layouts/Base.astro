---
import '@fontsource-variable/rubik';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/caveat';
import '../styles/global.css';
import type { Dictionary } from '../i18n';
import { dictionaries, socials } from '../i18n';
import { TINT } from '../lib/ornament.js';
import ConsentBanner from '../components/ConsentBanner.astro';

/* The GA4 web stream for dimhold.by. Public by nature — it travels in every
   request the tag makes — so it lives in the repo rather than in a secret.
   The env var is there for anyone forking this to point it at their own. */
const GA_ID = import.meta.env.PUBLIC_GA_ID ?? 'G-B61RBJ7WTJ';
const analytics = import.meta.env.PROD && GA_ID;

interface Props {
  t: Dictionary;
  title?: string;
  description?: string;
  /** Language alternates for this page; defaults to the three home pages. */
  alternates?: { lang: string; href: string }[];
  ogType?: string;
}

const {
  t,
  title = t.metaTitle,
  description = t.metaDescription,
  alternates: alternatesProp,
  ogType = 'profile',
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
/* The page's own preview card, drawn by /scripts/gen-og.mjs. The name follows
   the URL rather than being passed down from each page, so a new post gets its
   card from `npm run og` and nothing here has to change. Anything without a
   card of its own — the 404, say — falls back to the site card. */
function ogCard(pathname: string) {
  const seg = pathname.split('/').filter(Boolean);
  const lang = seg[0] === 'ru' || seg[0] === 'be' ? seg.shift() : 'en';
  if (seg.length === 0) return `/og/home-${lang}.jpg`;
  if (seg.length === 1 && (seg[0] === 'blog' || seg[0] === 'projects')) return `/og/${seg[0]}-${lang}.jpg`;
  if (seg.length === 2 && seg[0] === 'blog') return `/og/post-${seg[1]}-${lang}.jpg`;
  return '/og.jpg';
}

const ogImage = new URL(ogCard(Astro.url.pathname), site);
const ogLocale = { en: 'en_US', ru: 'ru_RU', be: 'be_BY' }[t.lang];
const alternates = (
  alternatesProp ?? Object.values(dictionaries).map((d) => ({ lang: d.lang, href: d.path }))
).map((a) => ({ lang: a.lang, href: new URL(a.href, site).href }));
const xDefault = alternates.find((a) => a.lang === 'en')?.href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dmitriy Semenkevich',
  url: site.href,
  email: 'mailto:dimhold@gmail.com',
  jobTitle: 'Full-stack engineer, co-founder of Adlega',
  worksFor: { '@type': 'Organization', name: 'Adlega', url: 'https://adlega.com' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Belarusian State University of Informatics and Radioelectronics',
  },
  // Country only. The city is nobody's business and search engines do not need it.
  address: { '@type': 'PostalAddress', addressCountry: 'BY' },
  sameAs: socials.map((s) => s.href),
  // The ORCID iD is both a profile link and a credential, so it goes in twice:
  // once in sameAs with the rest, once here as the identifier search engines read.
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'ORCID',
    value: 'https://orcid.org/0009-0009-3013-4978',
  },
};
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Day/night boot, and the day's tint: both run before first paint so
         there is no flash. The tint walks by two irrational steps, so the
         beige differs every day and never repeats a value; the matching
         ornament is charted from the same day number in /scripts/dayweave. -->
    <script is:inline define:vars={{ tint: TINT }}>
      (function () {
        try {
          var now = new Date();
          var day = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 864e5);
          var root = document.documentElement;
          root.dataset.day = day;
          root.style.setProperty('--tint-h', (tint.hBase + ((day * tint.phi) % 1) * tint.hSpan).toFixed(2));
          root.style.setProperty(
            '--tint-s',
            (tint.sBase + ((day * tint.plastic) % 1) * tint.sSpan).toFixed(2) + '%',
          );
        } catch (e) {}
        try {
          var hrs = new Date().getHours();
          var stored = null;
          try {
            stored = localStorage.getItem('lamp');
          } catch (e) {}
          var dark = stored
            ? stored === 'night'
            : hrs >= 22 || hrs < 6 || matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.mode = dark ? 'night' : 'day';
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Dmitriy Semenkevich" />
    <link rel="canonical" href={canonical.href} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="alternate" type="application/rss+xml" title="dimhold.by" href="/rss.xml" />
    <!-- The head from src/assets/favicon-source.png, dropped on a disc of the
         deep accent blue by /scripts/gen-favicon.mjs. The .ico carries 16/32/48
         because Google Search asks for 48 by name; the .png is what a browser
         paints in the tab. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Search Console. Ownership is already verified through the Analytics tag,
         but that proof dies the moment the tag is swapped or the property moves.
         This meta is a second, independent anchor: cheap, and it never expires. -->
    <meta name="google-site-verification" content="7fxwTcD9iTaEfMLm3-Wjf6_6D7oCSySQ1U4_B1PQUbc" />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2ebe0" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1d1813" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="dimhold.by" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@dimhold" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script>
      import '../scripts/dayweave';
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    {
      analytics && (
        <Fragment>
          {/* Consent Mode v2. The defaults are set before the tag itself loads,
              so the very first hit is already governed by them; wait_for_update
              gives a returning visitor's stored answer a moment to land before
              anything is sent. Advertising signals stay denied for good — this
              site does not advertise and never will.

              Written as plain statements. Astro treats script children as raw
              text, so an expression wrapper around them is emitted verbatim and
              the whole tag quietly does nothing. */}
          <script is:inline define:vars={{ gaId: GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
              functionality_storage: 'granted',
              security_storage: 'granted',
              wait_for_update: 500,
            });
            gtag('set', 'ads_data_redaction', true);
            gtag('set', 'url_passthrough', true);
            try {
              var stored = JSON.parse(localStorage.getItem('consent-analytics') || 'null');
              if (stored && stored.v === 'granted' && Date.now() - stored.at < 182 * 864e5) {
                gtag('consent', 'update', { analytics_storage: 'granted' });
              }
            } catch (e) {}
            gtag('js', new Date());
            // No anonymize_ip here: that is a Universal Analytics switch. GA4
            // never logs the address anyway, and passing it only bolts a junk
            // custom parameter onto every single event.
            gtag('config', gaId);
          </script>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
        </Fragment>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <div class="page">
      <slot />
    </div>
    {analytics && <ConsentBanner t={t} />}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
